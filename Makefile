# K9R5: Cheshire SoC (CVA6 + Ara) on FPGA.
#
# Includes Cheshire's build system with Bender rooted at this repo, so the
# overrides in Bender.local apply. Every Cheshire target is available, e.g.
# `make chs-hw-all` or `make chs-sw-all`. The k9r5-* targets below replace
# Ara's cheshire/Makefile, which assumes Ara is checked out inside Cheshire.
#
# Most targets run in the k9r5-fpga container. The host targets (see
# K9R5_HOST_GOALS) need neither Bender nor the RISC-V toolchains: k9r5-deps
# fetches submodules, and k9r5-sim* run QuestaSim, which is installed on the
# host. Run the container with the repo mounted at the same path as on the
# host, since generated scripts contain absolute paths.

K9R5_ROOT := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))

BENDER      ?= bender -d $(K9R5_ROOT)
BENDER_ROOT := $(K9R5_ROOT)/.bender
CHS_ROOT    := $(K9R5_ROOT)/cheshire
ARA_ROOT    := $(K9R5_ROOT)/ara
VIVADO      ?= vivado

# Host goals skip the includes below, which need Bender and the container.
K9R5_HOST_GOALS := k9r5-deps k9r5-sim-compile k9r5-sim-opt k9r5-sim
ifneq ($(MAKECMDGOALS),)
ifeq ($(filter-out $(K9R5_HOST_GOALS),$(MAKECMDGOALS)),)
K9R5_HOST_ONLY := 1
endif
endif

#################
# Host: sources #
#################

# Fetch submodules, including the CVA6 submodule its Bender sources need.
.PHONY: k9r5-deps
k9r5-deps:
	git -C $(K9R5_ROOT) submodule update --init
	git -C $(K9R5_ROOT)/cva6 submodule update --init core/cache_subsystem/hpdcache

###########################
# Host: QuestaSim (vsim)  #
###########################

# Run in the container first: `make chs-hw-all k9r5-sim-scripts` plus the
# software to simulate (e.g. `make k9r5-sw-ara`).
VSIM            ?= vsim
K9R5_VSIM_DIR   := $(CHS_ROOT)/target/sim/vsim
K9R5_SIM_BUILD  := $(K9R5_ROOT)/target/sim/build
# Cheshire's compile script, but with the testbench VIP patched by
# target/sim/patches/ (generated by k9r5-sim-scripts)
K9R5_VSIM_COMPILE := $(K9R5_VSIM_DIR)/compile.k9r5.tcl

# The testbench's C++ ELF loader (DPI) is built with the system g++, but vsim
# loads its own older bundled libstdc++, which lacks the newer symbols the
# system g++ emits. Preload the libstdc++ matching K9R5_VSIM_CXX instead (it is
# backward compatible). Questa's bundled GCC is no alternative on hosts with a
# recent glibc: its old linker cannot read the system's libm.
K9R5_VSIM_CXX ?= $(shell which g++)
K9R5_VSIM_RUN  = LD_PRELOAD=$(shell $(K9R5_VSIM_CXX) -print-file-name=libstdc++.so.6) $(VSIM)

# Testbench config 3 is Cheshire with Ara (gen_cheshire_ara_cfg() in
# tb_cheshire_pkg.sv); the ARA define alone only affects the FPGA top.
SELCFG   ?= 3
# Boot mode 0 (idle) preloads BINARY. Preload mode 1 (serial link) is far
# faster than 0 (JTAG); 2 = UART.
BOOTMODE ?= 0
PRELMODE ?= 1
BINARY   ?=
# Simulated-time limit per run ("-all" for none). A program that traps sits in
# Cheshire's trap handler forever, so without a limit a failing run never ends.
K9R5_SIM_TIMEOUT ?= 100ms
K9R5_SIM_LOG = $(K9R5_VSIM_DIR)/k9r5-sim.$(notdir $(BINARY)).log

# The testbench is optimized once per SELCFG (cached in the work library)
# instead of on every run; k9r5-sim-compile invalidates the cache.
K9R5_VOPT_ARGS  ?= -O5 +acc=npr+tb_cheshire_soc. +acc=npr+cheshire_soc. +acc=r+stream_xbar
K9R5_VSIM_FLAGS := -permissive -suppress 3009 -suppress 8386 -error 7
K9R5_VOPT_TOP    = tb_k9r5_cfg$(SELCFG)
K9R5_VOPT_STAMP  = $(K9R5_VSIM_DIR)/work/$(K9R5_VOPT_TOP).k9r5-stamp

# CPU state printed when a run stops, to identify traps (mcause/mepc/mtval)
K9R5_SIM_REPORT := set C {/tb_cheshire_soc/fix/dut/gen_cva6_cores[0]/i_core_cva6};\
 set R $$C/csr_regfile_i;\
 echo "[K9R5] Stopped at [now]: pc=[examine -radix hex $$C/pc_commit]\
 mcause=[examine -radix hex $$R/mcause_q] mepc=[examine -radix hex $$R/mepc_q]\
 mtval=[examine -radix hex $$R/mtval_q]"

.PHONY: k9r5-sim-compile k9r5-sim-opt k9r5-sim
k9r5-sim-compile:
	@test -f $(K9R5_VSIM_COMPILE) || \
		{ echo "Run 'make k9r5-sim-scripts' in the container first."; exit 1; }
	rm -f $(K9R5_VSIM_DIR)/work/*.k9r5-stamp
	cd $(K9R5_VSIM_DIR) && $(K9R5_VSIM_RUN) -c -do \
		'set rc [source $(K9R5_VSIM_COMPILE)]; if {$$rc ne "1"} {set rc [catch {vlog $(CHS_ROOT)/target/sim/src/elfloader.cpp -ccflags "-std=c++11" -cpppath $(K9R5_VSIM_CXX)}]}; quit -code [expr {$$rc eq "1"}]' \
		| tee compile.k9r5.log
	@! grep -qE '^# \*\* (Error|Fatal)' $(K9R5_VSIM_DIR)/compile.k9r5.log

k9r5-sim-opt: $(K9R5_VOPT_STAMP)
$(K9R5_VSIM_DIR)/work/tb_k9r5_cfg%.k9r5-stamp:
	@test -d $(K9R5_VSIM_DIR)/work || { echo "Run 'make k9r5-sim-compile' first."; exit 1; }
	cd $(K9R5_VSIM_DIR) && vopt $(K9R5_VSIM_FLAGS) tb_cheshire_soc -GSelectedCfg=$* \
		$(K9R5_VOPT_ARGS) -o tb_k9r5_cfg$* | tee vopt.k9r5.log
	@! grep -qE '^\*\* (Error|Fatal)' $(K9R5_VSIM_DIR)/vopt.k9r5.log
	touch $@

# Exits non-zero unless the testbench reports SUCCESS (over JTAG or serial link).
k9r5-sim: $(K9R5_VOPT_STAMP)
	@test -n "$(BINARY)" || { echo "Usage: make k9r5-sim BINARY=<elf>"; exit 1; }
	cd $(K9R5_VSIM_DIR) && $(K9R5_VSIM_RUN) -c $(K9R5_VOPT_TOP) -t 1ps $(K9R5_VSIM_FLAGS) \
		-cpppath $(K9R5_VSIM_CXX) +BOOTMODE=$(BOOTMODE) +PRELMODE=$(PRELMODE) +BINARY=$(abspath $(BINARY)) \
		-do 'set StdArithNoWarnings 1; set NumericStdNoWarnings 1; run $(K9R5_SIM_TIMEOUT); $(K9R5_SIM_REPORT); quit -f' \
		| tee $(K9R5_SIM_LOG)
	@grep -qE '\[(JTAG|SLINK)\] SUCCESS' $(K9R5_SIM_LOG)

ifndef K9R5_HOST_ONLY

# Ara configuration (see ara/config/); only 2_lanes is tested in Cheshire
ARA_CONFIGURATION ?= 2_lanes
include $(ARA_ROOT)/config/$(ARA_CONFIGURATION).mk

# CVA6 with the V extension and Ara attached to its accelerator port. Spatz is
# in the dependency tree, so its sources are always compiled: `-t spatz` makes
# Snitch use Spatz as its vector unit (TARGET_SPATZ) instead of its own.
CHS_BENDER_RTL_FLAGS := -t rtl -t cva6 -t cv64a6_imafdcv_sv39 -t exclude_first_pass_decoder -t spatz \
                        --define ARA --define NR_LANES=$(nr_lanes) --define VLEN=$(vlen)

all: chs-hw-all

include $(CHS_ROOT)/cheshire.mk

# Cheshire only regenerates its source scripts when its own Bender.yml changes,
# so these targets force a rebuild to pick up ARA_CONFIGURATION and overrides.
K9R5_BOARD ?= vcu128

.PHONY: k9r5-sim-scripts k9r5-xilinx k9r5-xilinx-program k9r5-xilinx-flash
K9R5_SIM_SCRIPTS := $(CHS_ROOT)/target/sim/vsim/compile.cheshire_soc.tcl \
                    $(CHS_ROOT)/target/sim/vcs/compile.cheshire_soc.sh

# chs-sim-all also downloads Cheshire's (partly non-free) flash/EEPROM models;
# see cheshire/README.md for their terms.
k9r5-sim-scripts:
	rm -f $(K9R5_SIM_SCRIPTS) $(K9R5_VSIM_COMPILE)
	$(MAKE) chs-sim-all $(K9R5_VSIM_COMPILE)

# Patched copy of Cheshire's testbench VIP, swapped into its compile script
K9R5_SIM_VIP_SRC := $(CHS_ROOT)/target/sim/src/vip_cheshire_soc.sv
K9R5_SIM_VIP     := $(K9R5_SIM_BUILD)/vip_cheshire_soc.sv
K9R5_SIM_VIP_PATCH := $(K9R5_ROOT)/target/sim/patches/vip_cheshire_soc.no-randomize.patch

$(K9R5_SIM_VIP): $(K9R5_SIM_VIP_SRC) $(K9R5_SIM_VIP_PATCH)
	mkdir -p $(dir $@)
	patch -s -o $@ $(K9R5_SIM_VIP_SRC) < $(K9R5_SIM_VIP_PATCH)

########################
# Spatz cluster (gen)  #
########################

# Generated from hw/spatz/k9r5.spatz_cluster.hjson into build/hw/spatz, leaving
# the spatz submodule untouched; the generated wrapper and bootrom replace the
# committed defaults via K9R5_SRC_SWAPS. Plan step 4.2.
SPATZ_ROOT          := $(K9R5_ROOT)/spatz
SPATZ_CLUSTER_DIR   := $(SPATZ_ROOT)/hw/system/spatz_cluster
K9R5_SPATZ_CFG      ?= $(K9R5_ROOT)/hw/spatz/k9r5.spatz_cluster.hjson
K9R5_HW_BUILD       := $(K9R5_ROOT)/build/hw
K9R5_SPATZ_GEN      := $(K9R5_HW_BUILD)/spatz/generated
K9R5_SPATZ_WRAPPER  := $(K9R5_SPATZ_GEN)/spatz_cluster_wrapper.sv
K9R5_SPATZ_BOOTROM  := $(K9R5_SPATZ_GEN)/bootrom.sv
K9R5_SPATZ_GCC      ?= $(SPATZ_ROOT)/install/riscv-gcc/bin/riscv32-unknown-elf-
PYTHON              ?= python3

# Spatz's tools call plain `bender`; this wrapper roots it at this repo, so they
# see the same spatz_vpu checkout as the build.
K9R5_BENDER_WRAP := $(K9R5_HW_BUILD)/bin/bender
$(K9R5_BENDER_WRAP):
	mkdir -p $(dir $@)
	printf '#!/bin/sh\nexec %s -d %s "$$@"\n' "$$(which bender)" "$(K9R5_ROOT)" > $@
	chmod +x $@

# encoding.h (used by the bootrom) from riscv-opcodes at Spatz's pinned version,
# with Spatz's extension list read from its Makefile (lazily: parsing is slow)
K9R5_OPCODES_COMMIT := $(shell cat $(SPATZ_ROOT)/sw/toolchain/riscv-opcodes.version)
K9R5_OPCODES_DIR    := $(K9R5_HW_BUILD)/riscv-opcodes-$(K9R5_OPCODES_COMMIT)
K9R5_SPATZ_OPCODES   = $(shell $(MAKE) -s -C $(SPATZ_ROOT) \
                       --eval='k9r5-print-opcodes: ; @echo $$(OPCODES)' k9r5-print-opcodes 2>/dev/null)
$(K9R5_OPCODES_DIR):
	git init -q $@
	git -C $@ remote add origin https://github.com/pulp-platform/riscv-opcodes.git
	git -C $@ fetch -q --depth 1 origin $(K9R5_OPCODES_COMMIT)
	git -C $@ checkout -q FETCH_HEAD
$(K9R5_HW_BUILD)/spatz/encoding.h: | $(K9R5_OPCODES_DIR)
	$(MAKE) -C $(K9R5_OPCODES_DIR) encoding.out.h EXTENSIONS='$(K9R5_SPATZ_OPCODES)'
	mkdir -p $(dir $@)
	cp $(K9R5_OPCODES_DIR)/encoding.out.h $@

# clustergen renders the wrapper, link.ld, bootdata and spatz_pkg.sv (inside
# the spatz_vpu checkout). It passes spatz_vpu only the config's file name,
# resolved from spatz_vpu/hw, hence the symlink there.
$(K9R5_SPATZ_WRAPPER): $(K9R5_SPATZ_CFG) $(K9R5_BENDER_WRAP)
	mkdir -p $(K9R5_HW_BUILD)/spatz
	ln -sf $(K9R5_SPATZ_CFG) $$($(K9R5_BENDER_WRAP) path spatz_vpu)/hw/$(notdir $(K9R5_SPATZ_CFG))
	PATH=$(dir $(K9R5_BENDER_WRAP)):$$PATH $(PYTHON) $(SPATZ_ROOT)/util/clustergen.py \
		-c $(K9R5_SPATZ_CFG) -o $(K9R5_HW_BUILD)/spatz

# Cluster bootrom: built from Spatz's bootrom.S with this config's bootdata
$(K9R5_SPATZ_BOOTROM): $(K9R5_SPATZ_WRAPPER) $(K9R5_HW_BUILD)/spatz/encoding.h \
		$(SPATZ_CLUSTER_DIR)/test/bootrom.S $(SPATZ_CLUSTER_DIR)/test/bootrom.ld
	$(K9R5_SPATZ_GCC)gcc -mabi=ilp32 -march=rv32imaf -static -nostartfiles \
		-T$(SPATZ_CLUSTER_DIR)/test/bootrom.ld $(SPATZ_CLUSTER_DIR)/test/bootrom.S \
		$(K9R5_SPATZ_GEN)/bootdata_bootrom.cc -I$(SPATZ_ROOT)/hw/ip/snitch_test/src \
		-I$(SPATZ_ROOT)/sw/snRuntime/include -I$(K9R5_HW_BUILD)/spatz -o $(K9R5_SPATZ_GEN)/bootrom.elf
	$(K9R5_SPATZ_GCC)objcopy -O binary $(K9R5_SPATZ_GEN)/bootrom.elf $(K9R5_SPATZ_GEN)/bootrom.bin
	$(PYTHON) $(SPATZ_ROOT)/util/generate_bootrom.py $(K9R5_SPATZ_GEN)/bootrom.bin \
		-c $(K9R5_SPATZ_CFG) --output $@

# Ara and spatz_vpu both define a package named rvv_pkg, with different
# contents, and SystemVerilog packages share one global namespace. Spatz's
# copies of the files that use it are renamed to spatz_rvv_pkg into build/hw
# and swapped into the generated source scripts (works for Vivado as well).
K9R5_SPATZ_VPU     := $(shell $(BENDER) path spatz_vpu 2>/dev/null)
K9R5_RVV_RENAME    := $(K9R5_HW_BUILD)/spatz_vpu
K9R5_RVV_SRCS      := $(shell grep -rlw rvv_pkg $(K9R5_SPATZ_VPU)/hw/src --include=*.sv 2>/dev/null)
K9R5_RVV_COPIES    := $(patsubst $(K9R5_SPATZ_VPU)/%,$(K9R5_RVV_RENAME)/%,$(K9R5_RVV_SRCS))
# spatz_pkg.sv is (re)generated by clustergen
$(K9R5_SPATZ_VPU)/hw/src/generated/spatz_pkg.sv: $(K9R5_SPATZ_WRAPPER)
$(K9R5_RVV_RENAME)/%: $(K9R5_SPATZ_VPU)/%
	mkdir -p $(dir $@)
	sed -E 's/\<rvv_pkg\>/spatz_rvv_pkg/g' $< > $@

.PHONY: k9r5-spatz-gen
k9r5-spatz-gen: $(K9R5_SPATZ_WRAPPER) $(K9R5_SPATZ_BOOTROM) $(K9R5_RVV_COPIES)

#########################################
# Source swaps in generated scripts     #
#########################################

# Tracked submodule files replaced by K9R5-built copies in Bender-generated
# source scripts, as <path relative to this repo>=<replacement>. Bender writes
# sources relative to $$ROOT (this repo).
K9R5_SRC_SWAPS = cheshire/target/sim/src/vip_cheshire_soc.sv=$(K9R5_SIM_VIP) \
                 spatz/hw/system/spatz_cluster/src/generated/spatz_cluster_wrapper.sv=$(K9R5_SPATZ_WRAPPER) \
                 spatz/hw/system/spatz_cluster/src/generated/bootrom.sv=$(K9R5_SPATZ_BOOTROM) \
                 $(foreach f,$(K9R5_RVV_SRCS),$(patsubst $(K9R5_ROOT)/%,%,$(f))=$(patsubst $(K9R5_SPATZ_VPU)/%,$(K9R5_RVV_RENAME)/%,$(f)))
K9R5_SRC_SWAP_DEPS = $(foreach s,$(K9R5_SRC_SWAPS),$(lastword $(subst =, ,$(s))))
k9r5_swap_from = $$ROOT/$(firstword $(subst =, ,$(1)))
k9r5_swap_to   = $(lastword $(subst =, ,$(1)))
# Fails if a swapped file is missing from the script (e.g. renamed upstream)
k9r5_swap_check = $(foreach s,$(K9R5_SRC_SWAPS),grep -qF '$(call k9r5_swap_from,$(s))' $(1) || \
                  { echo "$(call k9r5_swap_from,$(s)) not in $(1)"; exit 1; };)
k9r5_swap_sed   = $(foreach s,$(K9R5_SRC_SWAPS),-e 's|\$(call k9r5_swap_from,$(s))|$(call k9r5_swap_to,$(s))|')

# The elfloader line is dropped: k9r5-sim-compile builds it on the host,
# where the compiler vsim will load it with is known.
$(K9R5_VSIM_COMPILE): $(K9R5_VSIM_DIR)/compile.cheshire_soc.tcl $(K9R5_SRC_SWAP_DEPS)
	@$(call k9r5_swap_check,$<)
	sed $(k9r5_swap_sed) -e '/elfloader\.cpp/d' $< > $@

k9r5-xilinx:
	rm -f $(CHS_XILINX_DIR)/scripts/add_sources.$(K9R5_BOARD).tcl
	$(MAKE) $(CHS_XILINX_DIR)/scripts/add_sources.$(K9R5_BOARD).tcl
	$(MAKE) chs-xilinx-$(K9R5_BOARD)

k9r5-xilinx-program:
	$(MAKE) chs-xilinx-program-$(K9R5_BOARD)

k9r5-xilinx-flash:
	$(MAKE) chs-xilinx-flash-$(K9R5_BOARD)

###########################
# Ara bare-metal software #
###########################

# Ara's vector tests for Cheshire (ara/cheshire/sw), built with Cheshire's
# rules into sw/build/ara. Sources are copied flat, as Ara's own flow does,
# because the tests include their .body files and headers by bare name.
ARA_CHS_SW       := $(ARA_ROOT)/cheshire/sw
K9R5_SW_ARA_DIR  := $(K9R5_ROOT)/sw/build/ara
K9R5_SW_ARA_LINK ?= spm dram

K9R5_SW_ARA_C    := $(addprefix $(K9R5_SW_ARA_DIR)/,$(notdir \
                    $(wildcard $(ARA_CHS_SW)/src/*.c $(ARA_CHS_SW)/src/tests/*.c)))
K9R5_SW_ARA_DEPS := $(addprefix $(K9R5_SW_ARA_DIR)/,$(notdir \
                    $(wildcard $(ARA_CHS_SW)/include/*.h $(ARA_CHS_SW)/src/tests/body/*.body)))
K9R5_SW_ARA_ELF  := $(foreach l,$(K9R5_SW_ARA_LINK),$(K9R5_SW_ARA_C:.c=.$(l).elf))
K9R5_SW_ARA_ALL  := $(K9R5_SW_ARA_ELF) $(K9R5_SW_ARA_ELF:.elf=.dump)

# Cheshire's flags with the V extension. EEW and PRINTF default in
# rvv_test.h; pass ARA_EEW / ARA_PRINTF to override them. The rvv_test_*
# sources predate GCC 14, which made int-conversion and return-mismatch
# errors by default; keep them as warnings instead of patching Ara.
K9R5_SW_ARA_FLAGS := $(subst rv64gc,rv64gcv,$(CHS_SW_FLAGS)) -DCHESHIRE \
                     -Wno-error=int-conversion -Wno-error=return-mismatch \
                     -DNR_LANES=$(nr_lanes) -DVLEN=$(vlen) -DARA_NR_LANES=$(nr_lanes) \
                     $(if $(ARA_EEW),-DEEW=$(ARA_EEW)) $(if $(ARA_PRINTF),-DPRINTF=$(ARA_PRINTF))

# `private` keeps these flags off shared prerequisites such as libcheshire.a
$(K9R5_SW_ARA_ALL) $(K9R5_SW_ARA_C:.c=.o): private CHS_SW_FLAGS := $(K9R5_SW_ARA_FLAGS)
$(K9R5_SW_ARA_C:.c=.o): $(K9R5_SW_ARA_DEPS)
.SECONDARY: $(K9R5_SW_ARA_C)

# Copies get sw/patches/ara/<file>.patch applied when one exists (K9R5 fixes
# to Ara's sources, which stay untouched). Secondary expansion is enabled by
# Cheshire's xilinx.mk.
K9R5_SW_ARA_PATCHES := $(K9R5_ROOT)/sw/patches/ara
k9r5_sw_ara_copy = cp $< $@ && if [ -f $(K9R5_SW_ARA_PATCHES)/$(notdir $@).patch ]; then \
                   patch -s $@ < $(K9R5_SW_ARA_PATCHES)/$(notdir $@).patch; fi
k9r5_sw_ara_patch = $$(wildcard $(K9R5_SW_ARA_PATCHES)/$$(notdir $$@).patch)

$(K9R5_SW_ARA_DIR)/%.c: $(ARA_CHS_SW)/src/%.c $(k9r5_sw_ara_patch) | $(K9R5_SW_ARA_DIR)
	$(k9r5_sw_ara_copy)
$(K9R5_SW_ARA_DIR)/%.c: $(ARA_CHS_SW)/src/tests/%.c $(k9r5_sw_ara_patch) | $(K9R5_SW_ARA_DIR)
	$(k9r5_sw_ara_copy)
$(K9R5_SW_ARA_DIR)/%.h: $(ARA_CHS_SW)/include/%.h $(k9r5_sw_ara_patch) | $(K9R5_SW_ARA_DIR)
	$(k9r5_sw_ara_copy)
$(K9R5_SW_ARA_DIR)/%.body: $(ARA_CHS_SW)/src/tests/body/%.body $(k9r5_sw_ara_patch) | $(K9R5_SW_ARA_DIR)
	$(k9r5_sw_ara_copy)
$(K9R5_SW_ARA_DIR):
	mkdir -p $@

.PHONY: k9r5-sw-ara
k9r5-sw-ara: $(K9R5_SW_ARA_ALL)

##################################
# Ara standalone testbench (Verilator)
##################################

# Ara's own testbench: CVA6 + Ara with an ideal memory, verilated. It uses
# Ara's pinned dependencies (CVA6 alpha.1; Ara's crt0 enables the FPU itself,
# so the mstatus.FS bug does not affect it) and Ara's pinned Verilator, which
# the image installs in ara/install/verilator: with Verilator 5.050 about 30 of
# Ara's riscv-tests hang. Orders of magnitude faster than the SoC in Questa.
K9R5_ARA_HW         := $(ARA_ROOT)/hardware
K9R5_ARA_APPS       := $(ARA_ROOT)/apps
K9R5_ARA_VERIL_PATH ?= $(ARA_ROOT)/install/verilator/bin
K9R5_ARA_MODEL_DIR  := $(K9R5_ARA_HW)/build/verilator
K9R5_ARA_MODEL      := $(K9R5_ARA_MODEL_DIR)/Vara_tb_verilator
K9R5_ARA_ARGS       := config=$(ARA_CONFIGURATION)
K9R5_ARA_JOBS       ?= $(shell nproc)
# Seconds per riscv-test (the slowest passing one takes ~1 min on 2 lanes)
K9R5_ARA_TIMEOUT    ?= 300

.PHONY: k9r5-ara-verilate k9r5-ara-app k9r5-ara-sim k9r5-ara-riscv-tests

# Ara's own flow: check out its dependencies, apply its RAM-model patch (adds
# the DPI functions that load programs), then verilate. A model built with a
# different Verilator is rebuilt.
k9r5-ara-verilate:
	@test -x $(K9R5_ARA_VERIL_PATH)/verilator || \
		{ echo "No Verilator in $(K9R5_ARA_VERIL_PATH); rebuild the image or set K9R5_ARA_VERIL_PATH."; exit 1; }
	$(MAKE) -C $(K9R5_ARA_HW) checkout
	grep -q simutil_memload $(K9R5_ARA_HW)/deps/tech_cells_generic/src/rtl/tc_sram.sv || \
		$(MAKE) -C $(K9R5_ARA_HW) apply-patches
	v="$$($(K9R5_ARA_VERIL_PATH)/verilator --version)"; \
	if [ "$$(cat $(K9R5_ARA_MODEL_DIR)/k9r5-verilator-version 2>/dev/null)" != "$$v" ]; then \
		rm -rf $(K9R5_ARA_MODEL_DIR); fi
	$(MAKE) -C $(K9R5_ARA_HW) verilate $(K9R5_ARA_ARGS) veril_path=$(K9R5_ARA_VERIL_PATH)
	$(K9R5_ARA_VERIL_PATH)/verilator --version > $(K9R5_ARA_MODEL_DIR)/k9r5-verilator-version

# Build one of Ara's apps, e.g. `make k9r5-ara-app APP=fmatmul ARGS="32 32 32"`
# (ARGS defaults to ara/apps/common/default_args.mk). The input data is always
# regenerated, and the generated data.S is removed to keep the submodule clean.
APP  ?=
ARGS ?=
k9r5-ara-app:
	@test -n "$(APP)" || { echo "Usage: make k9r5-ara-app APP=<app> [ARGS=\"...\"]"; exit 1; }
	rm -f $(K9R5_ARA_APPS)/bin/$(APP) $(K9R5_ARA_APPS)/$(APP)/data.S $(K9R5_ARA_APPS)/$(APP)/data.S.o
	$(MAKE) -C $(K9R5_ARA_APPS) bin/$(APP) $(K9R5_ARA_ARGS) $(if $(ARGS),def_args_$(APP)="$(ARGS)")
	rm -f $(K9R5_ARA_APPS)/$(APP)/data.S

# Run an app built by k9r5-ara-app on the Verilator model. The model writes
# CVA6's instruction trace (trace_hart_0.dasm) to its working directory.
k9r5-ara-sim:
	@test -n "$(APP)" || { echo "Usage: make k9r5-ara-sim APP=<app>"; exit 1; }
	@test -x $(K9R5_ARA_MODEL) || { echo "Run 'make k9r5-ara-verilate' first."; exit 1; }
	cd $(K9R5_ARA_HW)/build && $(K9R5_ARA_MODEL) -l ram,$(K9R5_ARA_APPS)/bin/$(APP),elf

# Build and run all of Ara's riscv-tests in parallel (K9R5_ARA_TESTS="..." for
# a subset); fails unless all pass.
k9r5-ara-riscv-tests:
	@test -x $(K9R5_ARA_MODEL) || { echo "Run 'make k9r5-ara-verilate' first."; exit 1; }
	$(MAKE) -C $(K9R5_ARA_APPS) riscv_tests $(K9R5_ARA_ARGS)
	$(K9R5_ROOT)/util/ara-riscv-tests.sh $(K9R5_ARA_MODEL) $(K9R5_ARA_APPS)/bin \
		$(K9R5_ARA_HW)/build/riscv-tests $(K9R5_ARA_JOBS) $(K9R5_ARA_TIMEOUT)

endif # K9R5_HOST_ONLY
